NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://careerflow:careerflow@localhost:5432/careerflow
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careerflow-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SESSION_SECRET=replace-me-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
EMPLOYER_URL=http://localhost:3002
# Production only: configure a unique one-time token before first-admin setup.
ADMIN_BOOTSTRAP_TOKEN=
SMTP_URL=smtp://localhost:1025
STORAGE_DIR=./data/uploads

# M5 MEH connected mode — keep unset/blank for offline-only operation
# Connected requests require all three MEH_PROVIDER_* values; there is no fallback to other API keys.
MEH_PROVIDER_URL=
MEH_PROVIDER_KEY=
MEH_PROVIDER_MODEL=
MEH_SYSTEM_PROMPT=

# Email (MailHog in dev = port 1025; production = Postmark/Resend/SES)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerFlow <noreply@careerflow.local>
EMAIL_ENABLED=false

# Payment provider: none|stripe|paystack|paddle. "none" disables checkout.
PAYMENT_PROVIDER=none
