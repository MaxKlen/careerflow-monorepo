# Core runtime
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://careerflow:careerflow@localhost:5432/careerflow
SESSION_SECRET=replace-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
EMPLOYER_URL=http://localhost:3002
ADMIN_BOOTSTRAP_TOKEN=

# Local storage fallback. In production, use a dedicated absolute directory only when S3 is unset.
STORAGE_DIR=./data/uploads

# S3-compatible storage (AWS S3, Cloudflare R2, or MinIO). Leave credentials blank for local storage.
# Get AWS values from IAM; get R2 values from R2 > Manage R2 API Tokens.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email. Resend takes precedence when RESEND_API_KEY is set; otherwise SMTP/MailHog is used.
# Get Resend values from resend.com/api-keys. SMTP values come from the selected mail provider.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=CareerFlow <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerFlow <noreply@careerflow.local>

# Payments. none disables checkout; mock is local-demo-only. Live choices require credentials and signed webhook secrets.
PAYMENT_PROVIDER=none
DEMO_MODE=false
# Get Stripe keys/webhook secret from dashboard.stripe.com; price IDs are optional because checkout can use inline price data.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_GROWTH=
# Get Paymob API/integration/iframe/HMAC values from the Paymob merchant dashboard.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_API_URL=https://accept.paymob.com/api

# Connected MEH AI. No keys means offline deterministic guidance.
# Get Gemini keys from a Google AI Studio/Google Cloud project; OpenAI keys from platform.openai.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Existing OpenAI-compatible provider override remains supported.
MEH_PROVIDER_URL=
MEH_PROVIDER_KEY=
MEH_PROVIDER_MODEL=
MEH_SYSTEM_PROMPT=

# Web app build/runtime API URL
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CANDIDATE_BASE_PATH=
EMPLOYER_BASE_PATH=
ADMIN_BASE_PATH=
