{
  "name": "careerflow",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "prettier --check package.json pnpm-workspace.yaml .github/workflows/prettier-fix.yml",
    "test": "vitest run tests/config/*.test.ts apps/api/src/*.test.ts",
    "test:integration": "node tests/integration/api.integration.mjs",
    "test:integration:phase2": "node tests/integration/phase2-demo.integration.mjs",
    "test:integration:demo-seed": "pnpm --filter @careerflow/api exec tsx src/demoSeedPersistenceSmoke.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @careerflow/web build && pnpm --filter @careerflow/employer build && pnpm --filter @careerflow/admin build",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "dev:api": "pnpm --filter @careerflow/api dev",
    "dev:web": "pnpm --filter @careerflow/web dev",
    "db:push": "pnpm --filter @careerflow/db push",
    "db:generate": "pnpm --filter @careerflow/db generate",
    "db:migrate": "pnpm --filter @careerflow/db migrate",
    "smoke": "bash scripts/smoke.sh",
    "up": "docker compose -f docker/compose.yml up -d",
    "down": "docker compose -f docker/compose.yml down",
    "walkthrough:up": "bash scripts/walkthrough-up.sh",
    "walkthrough:seed": "bash scripts/walkthrough-seed.sh",
    "walkthrough:down": "bash scripts/walkthrough-down.sh",
    "dev:admin": "pnpm --filter @careerflow/admin dev",
    "dev:employer": "pnpm --filter @careerflow/employer dev",
    "demo:seed": "pnpm --filter @careerflow/api demo:seed",
    "demo:reset": "pnpm --filter @careerflow/api demo:reset",
    "demo:up": "bash scripts/demo-docker.sh up --build -d",
    "demo:tunnel-prepare": "bash scripts/demo-tunnel.sh prepare",
    "demo:tunnel-up": "bash scripts/demo-tunnel.sh start",
    "demo:down": "bash scripts/demo-docker.sh --profile gateway down"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
