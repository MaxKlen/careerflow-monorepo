{
  "name": "careerflow",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "prettier --check package.json pnpm-workspace.yaml tests playwright.config.ts .github docs",
    "test": "vitest run tests/config/*.test.ts",
    "test:integration": "node tests/integration/api.integration.mjs",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @careerflow/web build && pnpm --filter @careerflow/employer build && pnpm --filter @careerflow/admin build",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "dev:api": "pnpm --filter @careerflow/api dev",
    "dev:web": "pnpm --filter @careerflow/web dev",
    "db:push": "pnpm --filter @careerflow/db push",
    "db:generate": "pnpm --filter @careerflow/db generate",
    "db:migrate": "pnpm --filter @careerflow/db migrate",
    "smoke": "bash scripts/smoke.sh",
    "up": "docker compose -f docker/compose.yml up -d",
    "down": "docker compose -f docker/compose.yml down",
    "dev:admin": "pnpm --filter @careerflow/admin dev",
    "dev:employer": "pnpm --filter @careerflow/employer dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
